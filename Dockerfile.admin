FROM node:22-bookworm-slim AS deps
WORKDIR /app

COPY package*.json turbo.json tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages

RUN npm ci

FROM deps AS builder
ARG NEXT_PUBLIC_API_BASE_URL=https://api.merchflow.appbrainer.tech/v1
ARG NEXT_PUBLIC_LOGIN_APP_URL=https://merchflow.appbrainer.tech
ARG API_BASE_URL=https://api.merchflow.appbrainer.tech/v1

ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}
ENV NEXT_PUBLIC_LOGIN_APP_URL=${NEXT_PUBLIC_LOGIN_APP_URL}
ENV API_BASE_URL=${API_BASE_URL}

# Compile shared packages first so their ./dist/index.js exports are available
RUN npm run build --workspace @mvp/types && \
    npm run build --workspace @mvp/config && \
    npm run build --workspace @mvp/auth && \
    npm run build --workspace @mvp/rbac && \
    npm run build --workspace @mvp/admin-web

FROM node:22-bookworm-slim AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3001
ENV HOSTNAME=0.0.0.0

COPY --from=builder /app/apps/admin-web/.next/standalone ./
COPY --from=builder /app/apps/admin-web/.next/static ./apps/admin-web/.next/static
COPY --from=builder /app/apps/admin-web/public ./apps/admin-web/public

RUN chown -R node:node /app

USER node

EXPOSE 3001

CMD ["node", "apps/admin-web/server.js"]
