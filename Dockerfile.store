FROM node:22-bookworm-slim AS deps
WORKDIR /app

COPY package*.json turbo.json tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages

RUN npm ci

FROM deps AS builder
ARG NEXT_PUBLIC_API_BASE_URL=https://api.marketone.appbrainer.tech/v1
ARG API_BASE_URL=https://api.marketone.appbrainer.tech/v1
ARG NEXT_PUBLIC_APP_NAME="Market One BD"
ARG NEXT_PUBLIC_PRINT_AGENT_URL=http://127.0.0.1:17658

ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}
ENV API_BASE_URL=${API_BASE_URL}
ENV NEXT_PUBLIC_APP_NAME=${NEXT_PUBLIC_APP_NAME}
ENV NEXT_PUBLIC_PRINT_AGENT_URL=${NEXT_PUBLIC_PRINT_AGENT_URL}

RUN npm run build --workspace @mvp/store-web

FROM node:22-bookworm-slim AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3002

COPY --from=builder /app/apps/store-web/.next/standalone ./
COPY --from=builder /app/apps/store-web/.next/static ./apps/store-web/.next/static
COPY --from=builder /app/apps/store-web/public ./apps/store-web/public

EXPOSE 3002

CMD ["node", "apps/store-web/server.js"]
