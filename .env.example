# Shared local development variables for the monorepo.
# Copy to `.env` at the repo root and fill in real values.

# Database
POSTGRES_DB=multivendor
POSTGRES_USER=multivendor
POSTGRES_PASSWORD="change-me"
DATABASE_URL="postgresql://multivendor:change-me@localhost:5432/multivendor"

# Docker Compose support
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="change-me-minio-password"
PGADMIN_DEFAULT_PASSWORD="change-me-pgadmin-password"

# Bootstrap users
BOOTSTRAP_TENANT_CODE=multivendor
BOOTSTRAP_TENANT_NAME="Multi Vendor Platform"
BOOTSTRAP_PLATFORM_OWNER_NAME="Platform Owner"
BOOTSTRAP_PLATFORM_OWNER_EMAIL=owner@example.com
BOOTSTRAP_PLATFORM_OWNER_PASSWORD="change-me-owner-password"
BOOTSTRAP_PLATFORM_ADMIN_NAME="Platform Admin"
BOOTSTRAP_PLATFORM_ADMIN_EMAIL=nurprodev@gmail.com
BOOTSTRAP_PLATFORM_ADMIN_PASSWORD="change-me-admin-password"
BOOTSTRAP_STORE_OWNER_NAME="Store Owner"
BOOTSTRAP_STORE_OWNER_EMAIL=store@example.com
BOOTSTRAP_STORE_OWNER_PHONE="+8801000000000"
BOOTSTRAP_STORE_OWNER_PASSWORD="change-me-store-password"
BOOTSTRAP_STORE_CODE=STORE001
BOOTSTRAP_STORE_NAME="Demo Store"
BOOTSTRAP_STORE_SLUG=demo-store
BOOTSTRAP_STORE_PHONE="+8801000000000"

# Local app URLs
APP_URL="http://localhost:3000"
API_BASE_URL="http://localhost:4000/v1"
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000/v1"
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_ADMIN_APP_URL="http://localhost:3001"
NEXT_PUBLIC_STORE_APP_URL="http://localhost:3002"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_PRINT_AGENT_URL="http://127.0.0.1:17658"

# Optional local services
REDIS_URL="redis://localhost:6379"
STORAGE_LOCAL_DIR=".runtime-storage"
