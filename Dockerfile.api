FROM node:22-bookworm-slim AS deps
WORKDIR /app

COPY package*.json turbo.json tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages
COPY scripts ./scripts
COPY database ./database

RUN npm ci

FROM deps AS builder
RUN npm run build --workspace @mvp/api

FROM node:22-bookworm-slim AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV TS_NODE_PROJECT=apps/api/tsconfig.json
ENV TS_NODE_TRANSPILE_ONLY=true

COPY --from=builder /app/apps ./apps
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/database ./database
COPY --from=builder /app/scripts ./scripts
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/package*.json ./
COPY --from=deps /app/tsconfig.base.json ./

EXPOSE 4000

CMD ["sh", "-c", "node packages/database/src/migrate.mjs && node packages/database/src/seed.mjs && node --loader ts-node/esm apps/api/src/main.ts"]
