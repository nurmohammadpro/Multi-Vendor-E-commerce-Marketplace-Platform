FROM node:22-bookworm-slim AS deps
WORKDIR /app

COPY package*.json turbo.json tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages
COPY scripts ./scripts
COPY database ./database

RUN npm ci

FROM deps AS builder
RUN npm run build --workspace @mvp/types && \
    npm run build --workspace @mvp/config && \
    npm run build --workspace @mvp/auth && \
    npm run build --workspace @mvp/rbac && \
    npm run build --workspace @mvp/api

FROM node:22-bookworm-slim AS runner
WORKDIR /app

ENV NODE_ENV=production

COPY --from=builder /app/apps ./apps
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/database ./database
COPY --from=builder /app/scripts ./scripts
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/package*.json ./
COPY --from=deps /app/tsconfig.base.json ./

RUN chown -R node:node /app

USER node

EXPOSE 4000

# tsc output nests under dist/apps/api/src/ because baseUrl in
# tsconfig.base.json resolves to the monorepo root, so dist mirrors
# the source tree. Do not simplify to dist/main.js.
CMD ["sh", "-c", "node packages/database/src/migrate.mjs && node packages/database/src/seed.mjs && node apps/api/dist/apps/api/src/main.js"]
