FROM node:22-bookworm-slim AS deps
WORKDIR /app

COPY package*.json turbo.json tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages

RUN npm ci

FROM deps AS builder
ARG BUILD_WORKSPACE
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_ADMIN_APP_URL
ARG NEXT_PUBLIC_STORE_APP_URL
ARG NEXT_PUBLIC_APP_NAME
ARG NEXT_PUBLIC_ADMIN_APP_NAME
ARG NEXT_PUBLIC_PRINT_AGENT_URL
ARG API_BASE_URL
ARG ADMIN_DEMO_BEARER_TOKEN
ARG STORE_DEMO_BEARER_TOKEN
ARG STORE_DEMO_STORE_ID

ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}
ENV NEXT_PUBLIC_ADMIN_APP_URL=${NEXT_PUBLIC_ADMIN_APP_URL}
ENV NEXT_PUBLIC_STORE_APP_URL=${NEXT_PUBLIC_STORE_APP_URL}
ENV NEXT_PUBLIC_APP_NAME=${NEXT_PUBLIC_APP_NAME}
ENV NEXT_PUBLIC_ADMIN_APP_NAME=${NEXT_PUBLIC_ADMIN_APP_NAME}
ENV NEXT_PUBLIC_PRINT_AGENT_URL=${NEXT_PUBLIC_PRINT_AGENT_URL}
ENV API_BASE_URL=${API_BASE_URL}
ENV ADMIN_DEMO_BEARER_TOKEN=${ADMIN_DEMO_BEARER_TOKEN}
ENV STORE_DEMO_BEARER_TOKEN=${STORE_DEMO_BEARER_TOKEN}
ENV STORE_DEMO_STORE_ID=${STORE_DEMO_STORE_ID}

RUN npm run build --workspace "$BUILD_WORKSPACE"

FROM node:22-bookworm-slim AS runner
WORKDIR /app

ARG APP_DIR
ARG PORT

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV APP_DIR=${APP_DIR}
ENV PORT=${PORT}

COPY --from=builder /app/apps ./apps
COPY --from=builder /app/packages ./packages
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/package*.json ./

CMD ["sh", "-c", "npx next start \"$APP_DIR\" -H 0.0.0.0 -p \"${PORT:-3000}\""]
