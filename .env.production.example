# Production Environment Variables Template
# Copy this file to .env.production and fill in your actual values

# Database Configuration
DATABASE_URL="postgresql://username:password@production-host:5432/database_name"

# Application Configuration
NODE_ENV="production"
PORT="3000"

# JWT & Security (generate secure random values for production)
JWT_SECRET="your-super-secret-jwt-key-here"
SESSION_SECRET="your-session-secret-key-here"

# Add your production-specific environment variables below
# API keys, external service credentials, etc.