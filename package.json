{
  "name": "multi-vendor-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bash ./scripts/with-root-env.sh turbo build",
    "dev": "bash ./scripts/with-root-env.sh turbo dev",
    "lint": "bash ./scripts/with-root-env.sh turbo lint",
    "typecheck": "bash ./scripts/with-root-env.sh turbo typecheck",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "db:migrate": "bash ./scripts/with-root-env.sh node packages/database/src/migrate.mjs",
    "db:migrate:status": "bash ./scripts/with-root-env.sh node packages/database/src/migrate.mjs --status",
    "db:seed:bootstrap": "bash ./scripts/with-root-env.sh node packages/database/src/seed.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "turbo": "^2.0.14",
    "typescript": "^5.5.4"
  }
}
