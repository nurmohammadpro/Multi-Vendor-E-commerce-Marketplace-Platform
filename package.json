{
  "name": "multi-vendor-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:migrate": "node packages/database/src/migrate.mjs",
    "db:migrate:status": "node packages/database/src/migrate.mjs --status",
    "db:seed:bootstrap": "node packages/database/src/seed.mjs"
  },
  "devDependencies": {
    "turbo": "^2.0.14",
    "typescript": "^5.5.4"
  }
}
