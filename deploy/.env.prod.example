# Production environment for Hostinger KVM2 + Easypanel
# Copy into Easypanel environment variables or a protected `.env.prod` file.

POSTGRES_DB=multivendor
POSTGRES_USER=multivendor
POSTGRES_PASSWORD="replace-with-a-strong-production-password"

MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="replace-with-a-strong-production-minio-password"
PGADMIN_DEFAULT_PASSWORD="replace-with-a-strong-production-pgadmin-password"

DATABASE_URL="postgresql://multivendor:replace-with-a-strong-production-password@postgres:5432/multivendor"
REDIS_URL="redis://redis:6379"
STORAGE_DRIVER="s3"

APP_URL="https://app.yourdomain.com"
API_BASE_URL="https://api.yourdomain.com/v1"
NEXT_PUBLIC_API_BASE_URL="https://api.yourdomain.com/v1"
NEXT_PUBLIC_API_URL="https://api.yourdomain.com"
NEXT_PUBLIC_ADMIN_APP_URL="https://admin.yourdomain.com"
NEXT_PUBLIC_STORE_APP_URL="https://store.yourdomain.com"
NEXT_PUBLIC_APP_URL="https://app.yourdomain.com"
NEXT_PUBLIC_PRINT_AGENT_URL="http://127.0.0.1:17658"

BOOTSTRAP_TENANT_CODE=multivendor
BOOTSTRAP_TENANT_NAME="Multi Vendor Platform"
BOOTSTRAP_PLATFORM_OWNER_NAME="Platform Owner"
BOOTSTRAP_PLATFORM_OWNER_EMAIL=owner@yourdomain.com
BOOTSTRAP_PLATFORM_OWNER_PASSWORD="replace-with-a-strong-owner-password"
BOOTSTRAP_PLATFORM_ADMIN_NAME="Platform Admin"
BOOTSTRAP_PLATFORM_ADMIN_EMAIL=nurprodev@gmail.com
BOOTSTRAP_PLATFORM_ADMIN_PASSWORD="replace-with-a-strong-admin-password"
BOOTSTRAP_STORE_OWNER_NAME="Store Owner"
BOOTSTRAP_STORE_OWNER_EMAIL=store@yourdomain.com
BOOTSTRAP_STORE_OWNER_PHONE="+8801000000000"
BOOTSTRAP_STORE_OWNER_PASSWORD="replace-with-a-strong-store-password"
BOOTSTRAP_STORE_CODE=STORE001
BOOTSTRAP_STORE_NAME="Demo Store"
BOOTSTRAP_STORE_SLUG=demo-store
BOOTSTRAP_STORE_PHONE="+8801000000000"
