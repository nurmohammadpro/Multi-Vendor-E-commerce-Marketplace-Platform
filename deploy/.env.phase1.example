BOOTSTRAP_PLATFORM_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_PLATFORM_ADMIN_PHONE=
BOOTSTRAP_PLATFORM_ADMIN_PASSWORD=change-this-platform-admin-password
BOOTSTRAP_PLATFORM_ADMIN_LOCALE=en
NEXT_PUBLIC_PRINT_AGENT_URL=http://127.0.0.1:17658

API_PORT=3001
STORE_WEB_PORT=3000
ADMIN_WEB_PORT=3002

