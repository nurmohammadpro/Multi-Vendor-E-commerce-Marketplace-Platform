TZ=Asia/Dhaka

POSTGRES_DB=multivendor
POSTGRES_USER=multivendor
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_PORT=5432

REDIS_PORT=6379

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-this-pgadmin-password
PGADMIN_PORT=5050

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-minio-password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_REGION=ap-south-1
S3_BUCKET=multivendor
STORAGE_DRIVER=s3

POSTGRES_BACKUP_SCHEDULE=0 2 * * *
POSTGRES_BACKUP_KEEP_DAYS=7
POSTGRES_BACKUP_KEEP_WEEKS=4
POSTGRES_BACKUP_KEEP_MONTHS=6

APP_URL=https://app.example.com
NEXT_PUBLIC_APP_NAME=Multi Vendor Platform
NEXT_PUBLIC_ADMIN_APP_NAME=Multi Vendor Admin
NEXT_PUBLIC_API_BASE_URL=https://api.example.com/v1

API_PORT=3001
STORE_WEB_PORT=3000
ADMIN_WEB_PORT=3002

API_IMAGE=ghcr.io/example/multivendor-api:latest
STORE_WEB_IMAGE=ghcr.io/example/multivendor-store-web:latest
ADMIN_WEB_IMAGE=ghcr.io/example/multivendor-admin-web:latest
