# ──────────────────────────────────────────────
# Market One BD — Production Environment
# Deploy: Hostinger KVM2 + EasyPanel + Docker Compose
# Copy to .env and fill in real values before deploying.
# ──────────────────────────────────────────────

# Domain (set to your actual domain)
APP_URL="https://login.yourdomain.com"
API_BASE_URL="http://api:4000/v1"
NEXT_PUBLIC_API_BASE_URL="https://api.yourdomain.com/v1"
NEXT_PUBLIC_API_URL="https://api.yourdomain.com"
NEXT_PUBLIC_LOGIN_APP_URL="https://yourdomain.com"
NEXT_PUBLIC_ADMIN_APP_URL="https://admin.yourdomain.com"
NEXT_PUBLIC_STORE_APP_URL="https://app.yourdomain.com"
NEXT_PUBLIC_APP_URL="https://app.yourdomain.com"
NEXT_PUBLIC_APP_NAME="Market One BD"
NEXT_PUBLIC_ADMIN_APP_NAME="Market One Admin"

# Print agent (leave as-is unless using a thermal printer bridge)
NEXT_PUBLIC_PRINT_AGENT_URL="http://127.0.0.1:17658"

# API port (internal — keep 4000)
API_PORT=4000

# PostgreSQL
POSTGRES_DB=multivendor
POSTGRES_USER=multivendor
POSTGRES_PASSWORD="REPLACE-WITH-STRONG-PASSWORD-32CHARS"
DATABASE_URL="postgresql://multivendor:REPLACE-WITH-STRONG-PASSWORD-32CHARS@postgres:5432/multivendor"

# Redis
REDIS_URL="redis://redis:6379"

# S3-compatible storage (MinIO)
STORAGE_DRIVER=s3
S3_ENDPOINT="http://minio:9000"
S3_REGION="ap-south-1"
S3_BUCKET="multivendor"
MINIO_ROOT_USER="multivendor-minio"
MINIO_ROOT_PASSWORD="REPLACE-WITH-STRONG-MINIO-PASSWORD-32CHARS"
S3_ACCESS_KEY_ID="multivendor-minio"
S3_SECRET_ACCESS_KEY="REPLACE-WITH-STRONG-MINIO-PASSWORD-32CHARS"

# pgAdmin
PGADMIN_DEFAULT_EMAIL="admin@yourdomain.com"
PGADMIN_DEFAULT_PASSWORD="REPLACE-WITH-STRONG-PGADMIN-PASSWORD-32CHARS"

# Postgres backup schedule (daily at 2am)
POSTGRES_BACKUP_SCHEDULE="0 2 * * *"
POSTGRES_BACKUP_KEEP_DAYS=7
POSTGRES_BACKUP_KEEP_WEEKS=4
POSTGRES_BACKUP_KEEP_MONTHS=6

# ──────────────────────────────────────────────
# Bootstrap users (used by seed script)
# ──────────────────────────────────────────────
BOOTSTRAP_TENANT_CODE=multivendor
BOOTSTRAP_TENANT_NAME="Market One BD"
BOOTSTRAP_PLATFORM_OWNER_NAME="Platform Owner"
BOOTSTRAP_PLATFORM_OWNER_EMAIL=owner@yourdomain.com
BOOTSTRAP_PLATFORM_OWNER_PASSWORD="REPLACE-WITH-STRONG-OWNER-PASSWORD"
BOOTSTRAP_PLATFORM_ADMIN_NAME="Platform Admin"
BOOTSTRAP_PLATFORM_ADMIN_EMAIL=admin@yourdomain.com
BOOTSTRAP_PLATFORM_ADMIN_PASSWORD="REPLACE-WITH-STRONG-ADMIN-PASSWORD"
BOOTSTRAP_STORE_OWNER_NAME="Store Owner"
BOOTSTRAP_STORE_OWNER_EMAIL=store@yourdomain.com
BOOTSTRAP_STORE_OWNER_PHONE="+8801000000000"
BOOTSTRAP_STORE_OWNER_PASSWORD="REPLACE-WITH-STRONG-STORE-PASSWORD"
BOOTSTRAP_STORE_CODE=STORE001
BOOTSTRAP_STORE_NAME="Demo Store"
BOOTSTRAP_STORE_SLUG=demo-store
BOOTSTRAP_STORE_PHONE="+8801000000000"

# Demo tokens (optional — set if you want pre-authenticated demo access)
ADMIN_DEMO_BEARER_TOKEN=
STORE_DEMO_BEARER_TOKEN=
STORE_DEMO_STORE_ID=
